BREW_DEPLOYER_ACCOUNT=dev
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

BREW_ESCROW_ADDRESS=0x9Ddb398600E37a7b68936D316b6889EE21e0EAe9
BREW_VERIFIER_ADDRESS=0xe9aD090798B0CEDb2aaCA48d202f02071ccfb7e5

# Demo only. When true, any EAS attester can satisfy registered template issuer checks.
# Keep this false for production-style demos that rely on issuer allowlists.
BREW_DEMO_OPEN_ISSUER_MODE=true

# Optional. ConfigureReviewCoordinator falls back to vm.getWallets()[0]
# when this is missing or empty.
BREW_REVIEW_COORDINATOR_ADDRESS=

# Fork simulation only. Must match the configured review coordinator signer.
# Do not store a production/private demo key here.
BREW_REVIEW_COORDINATOR_PRIVATE_KEY=

# Optional demo token path.
DEMO_TOKEN_RECIPIENT=
DEMO_TOKEN_ADDRESS=0x63c972a697dFc788EadC61d9Bdd4BcfEb2abdf7C

BASESCAN_API_KEY=
