# Service bind address.
HOST=127.0.0.1
PORT=8787

# Sepolia AttestationVerifier address used as the EIP-712 verifying contract.
BREW_VERIFIER_ADDRESS=0xe5b3217407cee7F5cDa16946A257bC362D785b56

# Server-side EIP-712 signer. This address must be allowlisted on AttestationVerifier.
BREW_REVIEW_COORDINATOR_PRIVATE_KEY=
BREW_REVIEW_COORDINATOR_ADDRESS=

# Optional bearer token required by POST /review-receipt and GET /storage/:root.
BREW_REVIEW_RECEIPT_API_KEY=
BREW_REVIEW_RECEIPT_CHAIN_ID=11155111
BREW_REVIEW_RECEIPT_TTL_SECONDS=604800

# 0G Storage uploader. BREW_0G_STORAGE_PRIVATE_KEY falls back to ZERO_G_PRIVATE_KEY.
BREW_0G_STORAGE_PRIVATE_KEY=
ZERO_G_PRIVATE_KEY=
BREW_0G_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
BREW_0G_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BREW_0G_STORAGE_URI_PREFIX=0g://storage
BREW_0G_STORAGE_RETRIES=2

# Local kill-test defaults.
BREW_RECEIPT_SERVICE_URL=http://127.0.0.1:8787/review-receipt
BREW_REVIEW_TEST_TRUST_ID=
BREW_REVIEW_TEST_BENEFICIARY=
BREW_REVIEW_TEST_TEMPLATE_ID=
BREW_REVIEW_TEST_ATTESTATION_UID=
