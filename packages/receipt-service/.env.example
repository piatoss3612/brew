# Service bind address.
# Local: HOST=127.0.0.1 and PORT=8787 are convenient.
# Railway: set HOST=0.0.0.0 and do not set PORT manually; Railway injects PORT.
HOST=127.0.0.1
PORT=8787

# Base Sepolia AttestationVerifier address used as the EIP-712 verifying contract.
BREW_VERIFIER_ADDRESS=0x0d0f391bFFd1611aC1Ae3675AdFAf47A72320062

# Server-side EIP-712 signer. This address must be allowlisted on AttestationVerifier.
BREW_REVIEW_COORDINATOR_PRIVATE_KEY=
BREW_REVIEW_COORDINATOR_ADDRESS=

# Optional bearer token required by POST /review-receipt and GET /storage/:root.
BREW_REVIEW_RECEIPT_API_KEY=
BREW_REVIEW_RECEIPT_CHAIN_ID=84532
BREW_REVIEW_RECEIPT_TTL_SECONDS=604800

# 0G Storage uploader. BREW_0G_STORAGE_PRIVATE_KEY falls back to ZERO_G_PRIVATE_KEY.
BREW_0G_STORAGE_PRIVATE_KEY=
ZERO_G_PRIVATE_KEY=
BREW_0G_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
BREW_0G_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BREW_0G_STORAGE_URI_PREFIX=0g://storage
BREW_0G_STORAGE_RETRIES=2

# 0G Compute review swarm. Receipt-service calls 0G Compute; KeeperHub does not.
OG_COMPUTE_SERVICE_URL=https://compute-network-6.integratenetwork.work
OG_COMPUTE_PROXY_URL=
OG_COMPUTE_MODEL=qwen/qwen-2.5-7b-instruct
OG_COMPUTE_APP_SECRET=
OG_COMPUTE_TIMEOUT_MS=120000
OG_COMPUTE_MAX_TOKENS=512

# KeeperHub workflow webhook. Optional for receipt-only tests; required when executeRelease=true.
# The KeeperHub workflow receives the signed receipt and performs the web3 action.
KEEPERHUB_WEBHOOK_URL=
KEEPERHUB_WEBHOOK_API_KEY=
KEEPERHUB_WEBHOOK_TIMEOUT_MS=60000

# 0G Agentic ID references for the review swarm.
# Mint three Agentic ID tokens on 0G Galileo and authorize this service's executor address.
BREW_AGENTIC_ID_CHAIN=0g-galileo
BREW_AGENTIC_ID_CONTRACT=0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F
BREW_AGENTIC_AUTHORIZED_EXECUTOR=
BREW_EVIDENCE_AGENTIC_ID=
BREW_EVIDENCE_AGENTIC_TOKEN_ID=
BREW_EVIDENCE_AGENTIC_METADATA_HASH=
BREW_POLICY_AGENTIC_ID=
BREW_POLICY_AGENTIC_TOKEN_ID=
BREW_POLICY_AGENTIC_METADATA_HASH=
BREW_RISK_AGENTIC_ID=
BREW_RISK_AGENTIC_TOKEN_ID=
BREW_RISK_AGENTIC_METADATA_HASH=

# Local kill-test defaults.
BREW_RECEIPT_SERVICE_URL=http://127.0.0.1:8787/review-receipt
BREW_REVIEW_TEST_TRUST_ID=
BREW_REVIEW_TEST_BENEFICIARY=
BREW_REVIEW_TEST_TEMPLATE_ID=
BREW_REVIEW_TEST_ATTESTATION_UID=
