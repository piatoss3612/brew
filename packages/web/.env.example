# Web/Vercel runtime only.
# Secrets for 0G Compute, 0G Storage, coordinator signing, and KeeperHub webhook live in packages/receipt-service.

# Base Sepolia contract/indexer endpoints.
NEXT_PUBLIC_BREW_ESCROW_ADDRESS=0xBB3e0B8f1F31e1dDac553A43F1fcEe305Cff38f2
NEXT_PUBLIC_BREW_VERIFIER_ADDRESS=0x0d0f391bFFd1611aC1Ae3675AdFAf47A72320062
NEXT_PUBLIC_BREW_TOKEN_ADDRESS=0x63c972a697dFc788EadC61d9Bdd4BcfEb2abdf7C
NEXT_PUBLIC_BREW_SUBGRAPH_URL=https://api.studio.thegraph.com/query/71401/brew/version/latest

# Optional display id for the release workflow.
KEEPERHUB_WORKFLOW_ID=kh://workflow/verify-and-release

# Organization-scoped REST API key. Prefix should be kh_.
# Used by /api/keeperhub/execution to read workflow executions/status/logs.
KEEPERHUB_API_KEY=

# Optional. Defaults to https://app.keeperhub.com.
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com

# The web app only calls the deployed receipt-service. Do not set signer keys in Vercel.
BREW_REVIEW_RECEIPT_API_KEY=
BREW_REVIEW_RECEIPT_URL=http://127.0.0.1:8787/review-receipt
