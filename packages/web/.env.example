# KeeperHub workflow integration
# Workflow id from the KeeperHub workflow URL or GET /api/workflows.
KEEPERHUB_WORKFLOW_ID=

# Organization-scoped REST API key. Prefix should be kh_.
# Used by /api/keeperhub/execution to read workflow executions/status/logs.
KEEPERHUB_API_KEY=

# Optional. Defaults to https://app.keeperhub.com.
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com

# Webhook trigger URL for the Brew workflow.
# Usually: https://app.keeperhub.com/api/workflows/<workflow-id>/webhook
KEEPERHUB_WEBHOOK_URL=

# User-scoped webhook trigger API key. Prefix should be wfb_.
# Used only server-side by /api/keeperhub/trigger.
KEEPERHUB_WEBHOOK_API_KEY=

# 0G Compute direct proxy kill-test
# Get OG_COMPUTE_APP_SECRET with:
#   0g-compute-cli inference get-secret --provider <PROVIDER_ADDRESS>
OG_COMPUTE_MODE=direct
OG_COMPUTE_PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836
OG_COMPUTE_RPC_URL=https://evmrpc-testnet.0g.ai
OG_COMPUTE_SERVICE_URL=https://compute-network-6.integratenetwork.work
OG_COMPUTE_PROXY_URL=
OG_COMPUTE_MODEL=qwen/qwen-2.5-7b-instruct
OG_COMPUTE_APP_SECRET=
OG_COMPUTE_TIMEOUT_MS=120000
OG_COMPUTE_MAX_TOKENS=512
OG_COMPUTE_PROCESS_RESPONSE=true

# 0G Compute SDK mode. Used when OG_COMPUTE_MODE=sdk or no proxy URL is set.
# Prefer a dedicated funded Galileo test wallet.
ZERO_G_PRIVATE_KEY=

# 0G Storage receipt persistence.
# BREW_0G_STORAGE_PRIVATE_KEY is optional if ZERO_G_PRIVATE_KEY is already set.
# The review receipt signer signs the returned storage root; it does not upload by itself.
BREW_0G_STORAGE_PRIVATE_KEY=
BREW_0G_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
BREW_0G_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
BREW_0G_STORAGE_URI_PREFIX=0g://storage
BREW_0G_STORAGE_RETRIES=2

# Optional JSON object used by yarn killtest:0g-review.
BREW_REVIEW_SAMPLE_JSON=

# Receipt service signer for EIP-712 ReviewReceipt generation.
# Must be allowlisted in AttestationVerifier.setReviewCoordinatorAllowed.
# KeeperHub Code node calls BREW_REVIEW_RECEIPT_URL after 0G review.
# That endpoint uploads the receipt artifact to 0G Storage, then signs the returned root.
# Keep the private key in packages/receipt-service; do not paste it into the KeeperHub code node.
# These local signer fields are only needed by the legacy Next API fallback.
BREW_REVIEW_COORDINATOR_PRIVATE_KEY=
BREW_REVIEW_COORDINATOR_ADDRESS=
BREW_REVIEW_RECEIPT_TTL_SECONDS=604800
BREW_REVIEW_RECEIPT_API_KEY=
BREW_REVIEW_RECEIPT_URL=http://127.0.0.1:8787/review-receipt

# 0G Agentic ID references for the review swarm.
# These are inlined into yarn print:keeperhub-0g-code.
BREW_AGENTIC_ID_CHAIN=0g-galileo
BREW_AGENTIC_ID_CONTRACT=
BREW_AGENTIC_AUTHORIZED_EXECUTOR=
BREW_EVIDENCE_AGENTIC_ID=
BREW_EVIDENCE_AGENTIC_TOKEN_ID=
BREW_EVIDENCE_AGENTIC_METADATA_HASH=
BREW_POLICY_AGENTIC_ID=
BREW_POLICY_AGENTIC_TOKEN_ID=
BREW_POLICY_AGENTIC_METADATA_HASH=
BREW_RISK_AGENTIC_ID=
BREW_RISK_AGENTIC_TOKEN_ID=
BREW_RISK_AGENTIC_METADATA_HASH=
